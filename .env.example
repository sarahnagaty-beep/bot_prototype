# Copy to .env and fill in. Nothing here is needed for offline/internal UAT -
# the bot logs the payloads it would send instead of sending them.

# --- WhatsApp Cloud API (Meta) -------------------------------------------
# Meta > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-before-uat

# Meta > App Settings > Basic > App Secret.
# Set this on any host reachable from the internet: it is what stops anyone
# from posting fake leads at /webhook.
WHATSAPP_APP_SECRET=

# --- Media ----------------------------------------------------------------
# Public base URL for unit photos and floor plans referenced in inventory.json.
MEDIA_BASE_URL=https://cdn.example.com/inventory
